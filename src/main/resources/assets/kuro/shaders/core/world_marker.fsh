#version 330

// GENERATED by tools/gen_shaders.py - edit the template there, not this file.
// Every Ui shape is ONE quad. The vertex stage passes:
//   q     = -1..1 across the quad (set from the UVs: u,v = -1, region 2, texture 1)
//   gui   = GUI-space position of the pixel (so we can measure in GUI pixels without any uniform)
//   vData = packed colour: rgb keep their top 6 bits, the low 2 bits of r,g,b hold a 6-bit parameter (radius / spread),
//           alpha is the real alpha.
// The quad's half size in GUI px is recovered from screen-space derivatives, so no per-shape uniforms are needed.
uniform sampler2D Sampler0;   // unused dummy sampler (the GUI pipeline always binds one)

in vec2 q;
in vec2 gui;
in vec4 vData;

out vec4 fragColor;

float sdRoundBox(vec2 p, vec2 b, float r) {
    vec2 d = abs(p) - b + r;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
}

float cover(float d, float aa) { return clamp(0.5 - d / aa, 0.0, 1.0); }

vec3 hsv2rgb(vec3 c) {
    vec3 p = abs(fract(c.xxx + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

// soft organic edge: pushes the outline inwards by 0..2 GUI px, different lobes per window size
float blobWobble(vec2 p, vec2 hs) {
    float ang = atan(p.y / max(hs.y, 1.0), p.x / max(hs.x, 1.0));
    float ph = hs.x * 0.173 + hs.y * 0.091;
    float w = sin(ang * 3.0 + ph) * 0.55 + sin(ang * 5.0 - ph * 1.7) * 0.45;
    return 1.0 * (1.0 + w);
}

void main() {
    // derivatives first, before any branching
    // Jacobian d(gui)/d(q): works for rotated quads too (lines). Its column lengths are the half sizes in GUI px.
    vec2 gx = dFdx(gui), gy = dFdy(gui), qx = dFdx(q), qy = dFdy(q);
    float det = qx.x * qy.y - qx.y * qy.x;
    det = abs(det) < 1e-12 ? 1e-12 : det;
    vec2 col0 = (gx * qy.y - gy * qx.y) / det;
    vec2 col1 = (gy * qx.x - gx * qy.x) / det;
    vec2 hs = vec2(length(col0), length(col1));                                       // half size in GUI px
    float aa = max(length(gx), 1e-4);                                                 // GUI px per screen px

    ivec4 b = ivec4(vData * 255.0 + 0.5);
    int code = ((b.r & 3) << 4) | ((b.g & 3) << 2) | (b.b & 3);
    vec3 rgb = vec3(b.rgb & 252) / 252.0;
    float a = vData.a;
    vec2 p = q * hs;
    float edgeFade = 1.0 - smoothstep(0.80, 1.0, max(abs(q.x), abs(q.y)));   // glows fade out before the quad border
    vec4 t = texture(Sampler0, vec2(0.5));   // keeps the sampler alive; contributes nothing
    float keep = t.a * 0.0;

    float fillK = float(code >> 2) / 15.0;
    float thick = (1.0 + float(code & 3)) * 1.5;
    if (q.x > 1.5) {                                   // dot
        vec2 l = (q - 2.0) * 2.0 - 1.0;
        float dd = length(l);
        float core = 1.0 - smoothstep(0.50, 0.70, dd);
        float halo = (1.0 - smoothstep(0.0, 1.0, dd)) * 0.45;
        fragColor = vec4(mix(rgb, vec3(1.0), core * 0.4), a * max(core, halo) + keep);
        return;
    }
    vec2 fw = abs(dFdx(q)) + abs(dFdy(q));              // uv change per screen pixel
    vec2 pe = min(q, 1.0 - q) / max(fw, vec2(1e-6));    // distance to each edge in screen px
    float e = min(pe.x, pe.y);
    float line = 1.0 - smoothstep(thick - 0.75, thick + 0.75, e);
    float glow = exp(-e / 7.0) * 0.50;
    float fill = fillK * (0.45 + 0.55 * exp(-e / 16.0));   // fuller towards the edges, like frosted glass
    float alpha = clamp(a * (line + glow * 0.7 + fill * 0.6), 0.0, 1.0);
    fragColor = vec4(mix(rgb, vec3(1.0), line * 0.35), alpha + keep);
}
