#version 330

// GENERATED by tools/gen_shaders.py - edit the template there, not this file.
uniform sampler2D Sampler0;   // SDF glyph atlas (tools/gen_sdf_font.py)

in vec2 q;
in vec2 gui;
in vec4 vData;

out vec4 fragColor;

void main() {
    ivec2 sz = textureSize(Sampler0, 0);
    vec2 st = q * vec2(sz) - 0.5;
    ivec2 i0 = ivec2(floor(st));
    vec2 f = fract(st);
    ivec2 hi = sz - ivec2(1);
    float s00 = texelFetch(Sampler0, clamp(i0, ivec2(0), hi), 0).r;
    float s10 = texelFetch(Sampler0, clamp(i0 + ivec2(1, 0), ivec2(0), hi), 0).r;
    float s01 = texelFetch(Sampler0, clamp(i0 + ivec2(0, 1), ivec2(0), hi), 0).r;
    float s11 = texelFetch(Sampler0, clamp(i0 + ivec2(1, 1), ivec2(0), hi), 0).r;
    float d = mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
    float w = max(fwidth(d), 1e-4);                                   // distance change per screen pixel -> exact 1 px edge
    float cov = clamp((d - 0.48) / (0.85 * w) + 0.5, 0.0, 1.0);
    fragColor = vec4(vData.rgb, vData.a * cov);
}
